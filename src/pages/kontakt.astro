---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Base
  title="Kontakt — Klinika Aurelia | Medycyna estetyczna Toruń"
  description="Umów konsultację w Klinice Aurelia w Toruniu. Zostaw kontakt — rejestracja oddzwoni w ciągu jednego dnia roboczego."
>
  <section class="px-6 pt-32 pb-24 lg:px-10 lg:pt-40 lg:pb-32">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <h1 id="contact-heading" class="text-[var(--ink)]">Umów konsultację</h1>
        <p id="contact-lead" class="mt-6 text-[18px] text-[var(--ink-soft)]">
          Zostaw kontakt — rejestracja oddzwoni w ciągu jednego dnia roboczego, żeby dobrać termin i odpowiedzieć na pytania.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-y-20 gap-x-28 lg:grid-cols-2">
        <ContactForm />

        <div class="flex flex-col gap-14">
          <div class="flex flex-col gap-4">
            <span class="overline">Dane kontaktowe</span>
            <div class="flex flex-col gap-2 text-[16px] text-[var(--ink-soft)]">
              <span class="text-[var(--ink)]">Klinika Aurelia</span>
              <span>ul. Mostowa 14/2, 87-100 Toruń</span>
              <a href="tel:512340218" class="transition-colors hover:text-[var(--gold)]">512 340 218</a>
              <a href="mailto:rejestracja@klinika-aurelia.pl" class="transition-colors hover:text-[var(--gold)]">
                rejestracja@klinika-aurelia.pl
              </a>
              <span>Pon–Pt 9:00–19:00, Sob 9:00–14:00</span>
            </div>
          </div>

          <div class="aspect-[4/3] w-full overflow-hidden border border-[var(--porcelain)]">
            <iframe
              src="https://www.google.com/maps?q=Toru%C5%84,+Polska&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mapa — centrum Torunia"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const cel = new URLSearchParams(window.location.search).get("cel");

    if (cel === "zapis") {
      const heading = document.getElementById("contact-heading");
      const lead = document.getElementById("contact-lead");
      if (heading) heading.textContent = "Zapisz się na zabieg";
      if (lead) lead.textContent = "Zostaw kontakt — rejestracja oddzwoni, żeby dobrać termin zabiegu.";
    }
  </script>
</Base>
