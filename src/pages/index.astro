---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import GoldArc from "../components/GoldArc.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TreatmentCard from "../components/TreatmentCard.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Testimonials from "../components/Testimonials.astro";
import FinalCta from "../components/FinalCta.astro";
import { treatments } from "../data/treatments";
import { Image } from "astro:assets";
import heroImage from "../assets/hero-main.webp";

const trustBar = [
  "12 lat doświadczenia",
  "9 000+ wykonanych zabiegów",
  "4,9/5 — 214 opinii Google",
  "Zabiegi wykonują wyłącznie lekarze",
];

const featuredSlugs = [
  "modelowanie-ust",
  "toksyna-botulinowa",
  "lifting-hifu",
  "mezoterapia-iglowa",
  "stymulator-tkankowy",
  "peeling-medyczny",
];

const modulePreviewLabels = ["Opadający owal twarzy", "Zbyt wąskie usta", "Zmarszczki poprzeczne czoła"];

const pricingHighlights = [
  { name: "Modelowanie ust", price: "od 1 100 zł" },
  { name: "Toksyna botulinowa", price: "od 600 zł" },
  { name: "Lifting HIFU", price: "od 2 900 zł" },
  { name: "Mezoterapia", price: "od 450 zł" },
];

const medicalClinicSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "Klinika Aurelia",
  url: Astro.site?.toString(),
  image: new URL("/images/og-cover.webp", Astro.site).toString(),
  telephone: "+48512340218",
  email: "rejestracja@klinika-aurelia.pl",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "ul. Mostowa 14/2",
    addressLocality: "Toruń",
    postalCode: "87-100",
    addressCountry: "PL",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 53.0138,
    longitude: 18.6058,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "09:00",
      closes: "14:00",
    },
  ],
};

const featured = featuredSlugs.map((slug) => treatments[slug]);
---

<Base
  title="Klinika Aurelia — Medycyna estetyczna Toruń"
  description="Klinika medycyny estetycznej w Toruniu. Naturalne efekty, certyfikowane preparaty, zabiegi wykonuje lekarz. Umów konsultację — Klinika Aurelia."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(medicalClinicSchema)} />
  </Fragment>

  <section class="relative overflow-hidden">
    <div class="mx-auto grid grid-cols-1 items-center gap-10 px-6 pt-[11.5rem] pb-10 lg:max-w-7xl lg:grid-cols-[60%_40%] lg:gap-14 lg:px-10 lg:pt-[12.5rem] lg:pb-12">
      <div class="relative flex flex-col items-start gap-5 lg:pr-8">
        <GoldArc size={200} class="pointer-events-none absolute -left-14 -top-14 -z-10 hidden opacity-70 lg:block" />

        <span class="overline hero-item" style="--delay: 0ms;">KLINIKA MEDYCYNY ESTETYCZNEJ · TORUŃ</span>

        <h1 class="hero-item text-[var(--ink)]" style="--delay: 120ms;">
          Naturalne piękno.<br />
          Medyczna <em class="font-normal italic">precyzja</em>.
        </h1>

        <p class="hero-item max-w-md text-[17px] text-[var(--ink-soft)]" style="--delay: 240ms;">
          Zabiegi dobiera lekarz — indywidualnie, bez szablonu i bez przesady.
        </p>

        <div class="hero-item flex flex-col items-start gap-3" style="--delay: 360ms;">
          <Button href="/kontakt" variant="primary">Umów konsultację</Button>
          <a href="tel:512340218" class="text-[14px] text-[var(--ink-soft)] transition-colors hover:text-[var(--gold)]">
            lub zadzwoń: 512 340 218
          </a>
        </div>
      </div>

      <div class="aspect-[4/5] max-h-[45vh] w-full overflow-hidden rounded-lg lg:max-h-[60vh]">
        <Image
          src={heroImage}
          alt="Kobieta o naturalnej, promiennej skórze — portret w klinice medycyny estetycznej Aurelia"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <div class="border-t border-[var(--porcelain)] bg-[var(--ivory)]">
      <ul class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-4 px-6 py-8 text-center sm:flex sm:flex-wrap sm:items-center sm:justify-center sm:gap-x-10 sm:gap-y-0 sm:py-8 lg:justify-between lg:px-10 lg:py-12">
        {trustBar.map((item, i) => (
          <li class:list={["text-[14px] text-[var(--ink-soft)]", i !== 0 && "sm:border-l sm:border-[var(--porcelain)] sm:pl-10"]}>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="reveal border-t border-[var(--porcelain)] bg-white px-6 py-14 lg:px-10 lg:py-20">
    <div class="mx-auto max-w-7xl">
      <SectionHeading overline="ZABIEGI" heading="Czym się zajmujemy" />

      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((treatment) => (
          <TreatmentCard treatment={treatment} class="border border-[var(--porcelain)]" compact />
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
        <a
          href="/cennik"
          class="inline-flex items-center gap-2 text-[15px] font-medium text-[var(--ink)] transition-colors hover:text-[var(--gold)]"
        >
          Zobacz wszystkie zabiegi →
        </a>
        <a
          href="/dobierz-zabieg"
          class="inline-flex items-center gap-2 text-[15px] font-medium text-[var(--ink)] transition-colors hover:text-[var(--gold)]"
        >
          Nie wiesz, co wybrać? Dobierz zabieg →
        </a>
      </div>
    </div>
  </section>

  <section id="dobierz-zabieg-teaser" class="reveal scroll-mt-24 border-t border-[var(--porcelain)] bg-[var(--ivory)] px-6 py-14 lg:px-10 lg:py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col items-start gap-5">
        <SectionHeading overline="TWOJA ŚCIEŻKA" heading="Nie wiesz, jaki zabieg wybrać?" />
        <p class="max-w-[65ch] text-[17px] text-[var(--ink-soft)]">
          Zaznacz, co Ci przeszkadza — pokażemy dopasowane zabiegi i wytłumaczymy, jak każdy przebiega.
        </p>
        <Button href="/dobierz-zabieg" variant="primary">Dobierz zabieg dla siebie →</Button>
      </div>

      <div class="pointer-events-none select-none border border-[var(--porcelain)] bg-white p-6 sm:p-8" aria-hidden="true">
        <div class="border border-[var(--porcelain)] bg-[var(--ivory)] px-4 py-3 text-[14px] text-[var(--ink-soft)]">
          Wpisz, co Cię niepokoi…
        </div>
        <div class="mt-5 flex flex-wrap gap-2.5">
          {modulePreviewLabels.map((label) => (
            <span class="border border-[var(--porcelain)] bg-[var(--ivory)] px-4 py-2 text-[13px] font-medium text-[var(--ink)]">
              {label}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="metamorfozy" class="reveal scroll-mt-24 border-t border-[var(--porcelain)] bg-white px-6 py-14 lg:px-10 lg:py-20">
    <div class="mx-auto max-w-7xl">
      <SectionHeading overline="EFEKTY" heading="Zobacz zmianę na własne oczy" align="center" />

      <div class="mx-auto mt-8 flex max-w-4xl snap-x snap-mandatory gap-6 overflow-x-auto pb-2 sm:grid sm:grid-cols-3 sm:overflow-visible sm:pb-0">
        <div class="w-[70vw] shrink-0 snap-start sm:w-auto">
          <BeforeAfter
            beforeSrc="/images/meta-usta-przed.webp"
            afterSrc="/images/meta-usta-po.webp"
            beforeAlt="Usta przed zabiegiem modelowania kwasem hialuronowym"
            afterAlt="Usta po zabiegu modelowania kwasem hialuronowym"
            label="Usta"
          />
        </div>
        <div class="w-[70vw] shrink-0 snap-start sm:w-auto">
          <BeforeAfter
            beforeSrc="/images/meta-czolo-przed.webp"
            afterSrc="/images/meta-czolo-po.webp"
            beforeAlt="Czoło przed zabiegiem toksyny botulinowej"
            afterAlt="Czoło po zabiegu toksyny botulinowej"
            label="Czoło"
          />
        </div>
        <div class="w-[70vw] shrink-0 snap-start sm:w-auto">
          <BeforeAfter
            beforeSrc="/images/meta-owal-przed.webp"
            afterSrc="/images/meta-owal-po.webp"
            beforeAlt="Owal twarzy przed zabiegiem liftingu HIFU"
            afterAlt="Owal twarzy po zabiegu liftingu HIFU"
            label="Owal twarzy"
          />
        </div>
      </div>

      <p class="mx-auto mt-8 max-w-[65ch] text-center text-[13px] text-[var(--ink-soft)]">
        Zdjęcia opublikowane za zgodą pacjentek. Efekt zabiegu jest zawsze kwestią indywidualną i może się różnić.
      </p>
    </div>
  </section>

  <section class="reveal border-t border-[var(--porcelain)] bg-[var(--ivory)] px-6 py-14 lg:px-10 lg:py-20">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 lg:grid-cols-2">
      <div class="aspect-[3/2] w-full overflow-hidden">
        <Image
          src="/images/wnetrze-recepcja.webp"
          alt="Recepcja kliniki Aurelia — jasne, minimalistyczne wnętrze z ciepłymi złotymi akcentami"
          width={1800}
          height={1200}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>

      <div class="flex flex-col gap-6">
        <SectionHeading overline="POZNAJMY SIĘ" heading="Miejsce, w którym możesz odetchnąć" />
        <p class="max-w-[65ch] text-[17px] text-[var(--ink-soft)]">
          Klinika Aurelia powstała z przekonania, że medycyna estetyczna to przede wszystkim medycyna. U nas każdy zabieg poprzedza rzetelna konsultacja lekarska, pracujemy wyłącznie na oryginalnych, certyfikowanych preparatach, a plan zabiegowy układamy pod Ciebie — nie pod promocję miesiąca.
        </p>

        <div class="flex items-start gap-4 border-l border-[var(--gold-soft)] pl-6">
          <div class="flex flex-col gap-3">
            <p class="font-display text-xl italic text-[var(--ink)]">
              „Najlepszy komplement, jaki możemy usłyszeć? »Nikt nie widzi, że coś robiłam — wszyscy mówią, że świetnie wyglądam.«"
            </p>
            <span class="text-[14px] text-[var(--ink-soft)]">dr n. med. Aurelia Zawadzka, założycielka</span>
          </div>
        </div>

        <a
          href="/o-nas"
          class="inline-flex items-center gap-2 text-[15px] font-medium text-[var(--ink)] transition-colors hover:text-[var(--gold)]"
        >
          Poznaj nasz zespół →
        </a>
      </div>
    </div>
  </section>

  <section class="reveal border-t border-[var(--porcelain)] bg-white px-6 py-14 lg:px-10 lg:py-20">
    <div class="mx-auto max-w-7xl">
      <SectionHeading overline="ZAUFANIE" heading="Pacjentki mówią same" align="center" />
      <div class="mt-8">
        <Testimonials />
      </div>
    </div>
  </section>

  <section class="reveal border-t border-[var(--porcelain)] bg-[var(--ivory)] px-6 py-14 lg:px-10 lg:py-20">
    <div class="mx-auto max-w-5xl">
      <SectionHeading overline="CENNIK" heading="Ile to kosztuje" align="center" />
      <p class="mx-auto mt-5 max-w-[65ch] text-center text-[17px] text-[var(--ink-soft)]">
        Ceny obejmują konsultację w dniu zabiegu, preparat i wizytę kontrolną. Konsultacja lekarska (150 zł) jest odliczana od ceny zabiegu.
      </p>

      <div class="mt-8 grid grid-cols-2 gap-6 lg:grid-cols-4">
        {pricingHighlights.map((item) => (
          <div class="flex flex-col items-center gap-1.5 border border-[var(--porcelain)] px-4 py-6 text-center">
            <span class="text-[15px] text-[var(--ink)]">{item.name}</span>
            <span class="text-[14px] text-[var(--ink-soft)]">{item.price}</span>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <Button href="/cennik" variant="primary">Zobacz pełny cennik →</Button>
      </div>
    </div>
  </section>

  <FinalCta background="white" compact />
</Base>

<style>
  .hero-item {
    opacity: 0;
    transform: translateY(16px);
    animation: hero-in 600ms ease-out forwards;
    animation-delay: var(--delay);
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-item {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
