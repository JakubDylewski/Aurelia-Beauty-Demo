---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import "../styles/global.css";

// Preload wag fontów użytych w treści widocznej bez przewijania (nagłówek hero,
// tekst podstawowy) — skraca czas do pierwszego renderu tekstu docelowego.
import cormorantDisplayFont from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-300-normal.woff2?url";
import instrumentBodyFont from "@fontsource/instrument-sans/files/instrument-sans-latin-ext-400-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = "/images/og-cover.webp" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={cormorantDisplayFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={instrumentBodyFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Przejdź do treści głównej</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      const revealElements = document.querySelectorAll<HTMLElement>(".reveal");

      if ("IntersectionObserver" in window && revealElements.length) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 },
        );

        revealElements.forEach((el) => observer.observe(el));
      } else {
        revealElements.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
