---
import Button from "./Button.astro";
import GoldArc from "./GoldArc.astro";

interface Props {
  background?: "ivory" | "white";
  compact?: boolean;
}

const { background = "ivory", compact = false } = Astro.props;

const bgClass = background === "white" ? "bg-white" : "bg-[var(--ivory)]";
const paddingClass = compact ? "px-6 py-14 lg:px-10 lg:py-20" : "px-6 py-24 lg:px-10 lg:py-32";
---

<section class:list={["reveal border-t border-[var(--porcelain)] text-center", bgClass, paddingClass]}>
  <div class="mx-auto flex max-w-2xl flex-col items-center gap-6">
    <GoldArc size={56} />
    <h2 class="text-[var(--ink)]">Zacznij od rozmowy</h2>
    <p class="text-[17px] text-[var(--ink-soft)]">
      Konsultacja lekarska kosztuje 150 zł i jest w całości odliczana od ceny zabiegu. Bez zobowiązań — czasem najlepszą rekomendacją jest „jeszcze nie teraz".
    </p>
    <div class="mt-2 flex flex-wrap items-center justify-center gap-6">
      <Button href="/kontakt" variant="primary">Umów konsultację</Button>
      <a href="tel:512340218" class="text-[15px] font-medium text-[var(--ink)] transition-colors hover:text-[var(--gold)]">
        lub zadzwoń: 512 340 218
      </a>
    </div>
  </div>
</section>
