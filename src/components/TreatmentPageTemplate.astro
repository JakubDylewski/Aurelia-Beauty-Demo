---
import QuickFacts from "./QuickFacts.astro";
import BeforeAfter from "./BeforeAfter.astro";
import FaqAccordion from "./FaqAccordion.astro";
import FinalCta from "./FinalCta.astro";
import TreatmentCard from "./TreatmentCard.astro";
import ContextBar from "./ContextBar.astro";
import DecisionSection from "./DecisionSection.astro";
import CompactDecisionCta from "./CompactDecisionCta.astro";
import { treatments, type TreatmentPageContent } from "../data/treatments";

interface Props {
  data: TreatmentPageContent;
}

const { data } = Astro.props;
const relatedTreatments = (data.relatedSlugs ?? []).map((slug) => treatments[slug]).filter(Boolean);
const treatmentName = treatments[data.slug]?.name ?? data.h1;
---

<section class="px-6 pt-[10.5rem] pb-16 lg:px-10 lg:pt-[12.5rem]">
  <div class="mx-auto max-w-4xl">
    <nav aria-label="Ścieżka nawigacji" class="mb-8 flex flex-wrap items-center gap-2 text-[13px] text-[var(--ink-soft)]">
      <a href="/" class="transition-colors hover:text-[var(--gold)]">Strona główna</a>
      <span aria-hidden="true">/</span>
      <a href="/cennik" class="transition-colors hover:text-[var(--gold)]">Zabiegi</a>
      <span aria-hidden="true">/</span>
      <span class="text-[var(--ink)]">{data.h1}</span>
    </nav>

    <ContextBar />

    <h1 class="text-[var(--ink)]">{data.h1}</h1>
    <p class="mt-6 max-w-2xl text-[18px] text-[var(--ink-soft)]">{data.lead}</p>

    <div class="mt-10">
      <QuickFacts facts={data.quickFacts} />
    </div>
  </div>
</section>

<section class="reveal border-t border-[var(--porcelain)] bg-[var(--ivory)] px-6 py-16 lg:px-10 lg:py-20">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-[var(--ink)]">Na czym polega</h2>
    <p class="mt-5 max-w-3xl text-[17px] text-[var(--ink-soft)]">{data.about}</p>
  </div>
</section>

<section class="reveal border-t border-[var(--porcelain)] px-6 py-16 lg:px-10 lg:py-20">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-[var(--ink)]">Dla kogo</h2>
    <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
      {data.indications.map((item) => (
        <li class="flex items-center gap-2.5 text-[16px] text-[var(--ink-soft)]">
          <span class="h-1 w-1 shrink-0 rounded-full bg-[var(--gold)]" aria-hidden="true"></span>
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="reveal border-t border-[var(--porcelain)] bg-[var(--ivory)] px-6 py-16 lg:px-10 lg:py-20">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-[var(--ink)]">Przebieg zabiegu</h2>
    <div class="mt-10 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {data.steps.map((step) => (
        <div class="flex flex-col gap-3">
          <span class="font-display text-4xl font-light text-[var(--gold)]">{step.number}</span>
          <h3 class="text-lg font-medium text-[var(--ink)]">{step.title}</h3>
          <p class="text-[15px] text-[var(--ink-soft)]">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{data.expectations && data.expectations.length > 0 && (
  <section class="reveal border-t border-[var(--porcelain)] px-6 py-16 lg:px-10 lg:py-20">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-[var(--ink)]">Czego się spodziewać</h2>
      <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-3">
        {data.expectations.map((item) => (
          <div class="flex flex-col gap-3">
            <h3 class="text-lg font-medium text-[var(--ink)]">{item.question}</h3>
            <p class="text-[15px] text-[var(--ink-soft)]">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<CompactDecisionCta treatmentName={treatmentName} />

<section class="reveal border-t border-[var(--porcelain)] bg-[var(--ivory)] px-6 py-16 lg:px-10 lg:py-20">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-[var(--ink)]">Efekty</h2>
    {data.beforeAfter ? (
      <Fragment>
        <div class="mt-10 max-w-xs">
          <BeforeAfter
            beforeSrc={data.beforeAfter.beforeSrc}
            afterSrc={data.beforeAfter.afterSrc}
            beforeAlt={data.beforeAfter.beforeAlt}
            afterAlt={data.beforeAfter.afterAlt}
            label={data.beforeAfter.label}
          />
        </div>
        <p class="mt-8 max-w-2xl text-[13px] text-[var(--ink-soft)]">
          Zdjęcia opublikowane za zgodą pacjentek. Efekt zabiegu jest zawsze kwestią indywidualną i może się różnić.
        </p>
      </Fragment>
    ) : (
      <Fragment>
        <p class="mt-5 max-w-2xl text-[17px] text-[var(--ink-soft)]">{data.effectsNote}</p>
        <p class="mt-6 max-w-2xl text-[13px] text-[var(--ink-soft)]">
          Efekt zabiegu jest zawsze kwestią indywidualną i może się różnić.
        </p>
      </Fragment>
    )}
  </div>
</section>

<section class="reveal border-t border-[var(--porcelain)] px-6 py-16 lg:px-10 lg:py-20">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-[var(--ink)]">Cennik</h2>
    <div class="mt-8 flex flex-col">
      {data.pricingTable.map((row) => (
        <div class="flex items-center justify-between gap-6 border-b border-[var(--porcelain)] py-4">
          <span class="text-[16px] text-[var(--ink)]">{row.label}</span>
          <span class="shrink-0 text-[16px] font-medium text-[var(--ink)]">{row.price}</span>
        </div>
      ))}
    </div>
  </div>
</section>

{data.contraindications && data.contraindications.length > 0 && (
  <section class="reveal border-t border-[var(--porcelain)] bg-[var(--ivory)] px-6 py-16 lg:px-10 lg:py-20">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-[var(--ink)]">Przeciwwskazania</h2>
      <ul class="mt-6 flex flex-col gap-3">
        {data.contraindications.map((item) => (
          <li class="flex items-start gap-2.5 text-[16px] text-[var(--ink-soft)]">
            <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-[var(--gold)]" aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>
      <p class="mt-6 text-[14px] text-[var(--ink-soft)]">
        Pełną listę przeciwwskazań omawiamy podczas konsultacji lekarskiej.
      </p>
    </div>
  </section>
)}

<section class="reveal border-t border-[var(--porcelain)] px-6 py-16 lg:px-10 lg:py-20">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-[var(--ink)]">Pytania i odpowiedzi</h2>
    <div class="mt-8">
      <FaqAccordion items={data.faq} idPrefix={data.slug} />
    </div>
  </div>
</section>

{relatedTreatments.length > 0 && (
  <section class="reveal border-t border-[var(--porcelain)] bg-[var(--ivory)] px-6 py-16 lg:px-10 lg:py-20">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-[var(--ink)]">{data.relatedLabel ?? "Często łączone z"}</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {relatedTreatments.map((treatment) => (
          <TreatmentCard treatment={treatment} />
        ))}
      </div>
      <a
        href="/dobierz-zabieg"
        class="mt-8 inline-block text-[15px] font-medium text-[var(--gold)] transition-colors hover:text-[var(--ink)]"
      >
        Nie ten zabieg? Dobierz inny →
      </a>
    </div>
  </section>
)}

<DecisionSection treatmentName={treatmentName} />

<FinalCta />
