---
import Base from "../layouts/Base.astro";
import Button from "./Button.astro";
import { treatments } from "../data/treatments";
import { cities, type CityPageData } from "../data/cities";

interface Props {
  city: CityPageData;
}

const { city } = Astro.props;

const allTreatments = Object.values(treatments);
const otherCities = Object.values(cities).filter((c) => c.slug !== city.slug);

const medicalClinicSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: "Klinika Aurelia",
  url: Astro.site?.toString(),
  image: new URL("/images/og-cover.webp", Astro.site).toString(),
  telephone: "+48512340218",
  email: "rejestracja@klinika-aurelia.pl",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "ul. Mostowa 14/2",
    addressLocality: "Toruń",
    postalCode: "87-100",
    addressCountry: "PL",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 53.0138,
    longitude: 18.6058,
  },
  areaServed: {
    "@type": "City",
    name: city.areaServed,
  },
};
---

<Base title={city.metaTitle} description={city.metaDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(medicalClinicSchema)} />
  </Fragment>

  <section class="px-6 pt-32 pb-16 lg:px-10 lg:pt-40">
    <div class="mx-auto max-w-3xl">
      <nav aria-label="Ścieżka nawigacji" class="mb-8 flex flex-wrap items-center gap-2 text-[13px] text-[var(--ink-soft)]">
        <a href="/" class="transition-colors hover:text-[var(--gold)]">Strona główna</a>
        <span aria-hidden="true">/</span>
        <span>Obsługiwane miejscowości</span>
        <span aria-hidden="true">/</span>
        <span class="text-[var(--ink)]">{city.cityName}</span>
      </nav>

      <h1 class="text-[var(--ink)]">Medycyna estetyczna {city.cityName}</h1>
      <p class="mt-6 max-w-[65ch] text-[18px] text-[var(--ink-soft)]">{city.lead}</p>

      <p class="mt-4 max-w-[65ch] text-[15px] text-[var(--ink-soft)]">
        Nasza klinika mieści się w Toruniu, przy ul. Mostowej 14/2 — pacjentki z {city.cityNameGenitive} dojeżdżają do nas w {city.travelTime}.
      </p>

      <p class="mt-6 max-w-[65ch] text-[16px] text-[var(--ink-soft)]">
        Klinika Aurelia to gabinet medycyny estetycznej działający w Toruniu od 12 lat. Każdy zabieg poprzedza konsultacja z
        lekarzem, który ocenia stan skóry i wspólnie z Tobą ustala plan działania. Pracujemy wyłącznie na certyfikowanych
        preparatach z pełną dokumentacją pochodzenia, a efekt zawsze dobieramy indywidualnie — bez szablonu i bez przesady.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2">
        {allTreatments.map((treatment) => (
          <a
            href={treatment.href}
            class="text-[15px] font-medium text-[var(--ink)] underline decoration-[var(--porcelain)] underline-offset-4 transition-colors hover:text-[var(--gold)]"
          >
            {treatment.name}
          </a>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-5">
        <Button href="/" variant="primary">Zobacz pełną ofertę kliniki →</Button>
        <Button href="/kontakt" variant="ghost">Umów konsultację</Button>
      </div>
    </div>
  </section>

  <section class="reveal border-t border-[var(--porcelain)] bg-[var(--ivory)] px-6 py-14 lg:px-10 lg:py-16">
    <div class="mx-auto grid max-w-3xl grid-cols-1 gap-8 sm:grid-cols-2 sm:items-center">
      <div class="aspect-[4/3] w-full overflow-hidden border border-[var(--porcelain)]">
        <iframe
          src="https://www.google.com/maps?q=Toru%C5%84,+ul.+Mostowa+14,+Polska&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Mapa dojazdu — ${city.cityName}`}
        ></iframe>
      </div>

      <div class="flex flex-col gap-2">
        <span class="overline">Dojazd z {city.cityName}</span>
        <p class="text-[15px] text-[var(--ink-soft)]">
          Trasa: {city.route}, w {city.travelTime} od {city.cityName === "Toruń" ? "centrum miasta" : city.cityNameGenitive}.
        </p>
      </div>
    </div>
  </section>

  <section class="reveal border-t border-[var(--porcelain)] px-6 py-10 lg:px-10 lg:py-12">
    <div class="mx-auto max-w-3xl">
      <span class="overline">Obsługujemy również:</span>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {otherCities.map((other) => (
          <a
            href={`/medycyna-estetyczna-${other.slug}`}
            class="text-[14px] text-[var(--ink-soft)] transition-colors hover:text-[var(--gold)]"
          >
            {other.cityName}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
