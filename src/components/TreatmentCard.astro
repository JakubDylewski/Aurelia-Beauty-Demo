---
import { Image } from "astro:assets";
import TreatmentImagePlaceholder from "./TreatmentImagePlaceholder.astro";
import { PLACEHOLDER_IMAGE, type Treatment } from "../data/treatments";

interface Props {
  treatment: Treatment;
  class?: string;
  /** Leaner tile: image + name + price only, no description/CTA label. */
  compact?: boolean;
}

const { treatment, class: className = "", compact = false } = Astro.props;
const hasOwnPhoto = treatment.image !== PLACEHOLDER_IMAGE;
---

<a
  href={treatment.href}
  class={`group flex flex-col overflow-hidden bg-white transition-transform duration-300 hover:-translate-y-1 ${className}`}
>
  <div class="aspect-[16/10] w-full overflow-hidden bg-[var(--porcelain)]">
    {hasOwnPhoto ? (
      <Image
        src={treatment.image}
        alt={treatment.imageAlt}
        width={800}
        height={500}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <TreatmentImagePlaceholder name={treatment.name} />
    )}
  </div>
  {compact ? (
    <div class="flex items-center justify-between gap-3 border border-t-0 border-[var(--porcelain)] px-4 py-3.5">
      <span class="font-display text-lg font-normal text-[var(--ink)]">{treatment.name}</span>
      <span class="shrink-0 text-[13px] font-medium text-[var(--ink-soft)]">{treatment.price}</span>
    </div>
  ) : (
    <div class="flex flex-1 flex-col gap-2 border border-t-0 border-[var(--porcelain)] p-6">
      <h3 class="font-display text-2xl font-normal text-[var(--ink)]">{treatment.name}</h3>
      <p class="flex-1 text-[15px] text-[var(--ink-soft)]">{treatment.description}</p>
      <div class="mt-2 flex items-center justify-between">
        <span class="text-[14px] font-medium text-[var(--ink)]">{treatment.price}</span>
        <span class="text-[14px] font-medium text-[var(--gold)] transition-colors group-hover:text-[var(--ink)]">
          {treatment.ctaLabel}
        </span>
      </div>
    </div>
  )}
</a>
