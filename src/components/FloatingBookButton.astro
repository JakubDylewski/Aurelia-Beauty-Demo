---
const isContactPage = Astro.url.pathname.replace(/\/$/, "") === "/kontakt";
---

{!isContactPage && (
  <a
    href="/kontakt"
    class="fixed bottom-4 right-4 z-30 inline-flex items-center gap-2 border border-[var(--ink)] bg-[var(--porcelain)] px-5 py-3 text-[14px] font-medium text-[var(--ink)] shadow-lg transition-colors duration-300 hover:border-[var(--gold)] hover:bg-[#EADDD7] hover:text-[var(--gold)] lg:hidden"
  >
    Umów wizytę
  </a>
)}
