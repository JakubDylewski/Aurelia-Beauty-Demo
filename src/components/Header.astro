---
import GoldArc from "./GoldArc.astro";

const zabiegiCategories = [
  {
    label: "Twarz",
    items: [
      { label: "Toksyna botulinowa", href: "/zabiegi/toksyna-botulinowa" },
      { label: "Lifting HIFU", href: "/zabiegi/lifting-hifu" },
      { label: "Stymulator tkankowy", href: "/zabiegi/stymulator-tkankowy" },
      { label: "Wypełniacz kwasem hialuronowym", href: "/zabiegi/wypelniacz-kwas-hialuronowy" },
      { label: "Wypełnienie doliny łez", href: "/zabiegi/wypelnienie-doliny-lez" },
      { label: "Lipoliza iniekcyjna", href: "/zabiegi/lipoliza-iniekcyjna" },
    ],
  },
  {
    label: "Usta",
    items: [
      { label: "Modelowanie ust", href: "/zabiegi/modelowanie-ust" },
      { label: "Nawilżająca mezoterapia ust", href: "/zabiegi/nawilzajaca-mezoterapia-ust" },
      { label: "Korekta ust z hialuronidazą", href: "/zabiegi/korekta-ust-hialuronidaza" },
    ],
  },
  {
    label: "Skóra",
    items: [
      { label: "Mezoterapia igłowa", href: "/zabiegi/mezoterapia-iglowa" },
      { label: "Peeling medyczny", href: "/zabiegi/peeling-medyczny" },
    ],
  },
];

const zabiegiUtility = [
  { label: "Konsultacja lekarska", href: "/zabiegi/konsultacja-lekarska" },
  { label: "Pełny cennik", href: "/cennik" },
];

const navLinks = [
  { label: "Dobierz zabieg", href: "/dobierz-zabieg" },
  { label: "Metamorfozy", href: "/#metamorfozy" },
  { label: "O nas", href: "/o-nas" },
  { label: "Cennik", href: "/cennik" },
  { label: "Kontakt", href: "/kontakt" },
];

// Treść jeszcze nie istnieje — pozycja widoczna w menu, ale bez aktywnego linku do czasu zbudowania strony.
const upcomingNavLabel = "Pierwsza wizyta";
---

<header id="site-header" class="fixed inset-x-0 top-10 z-50 transition-all duration-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10">
    <a href="/" class="flex flex-col leading-none">
      <span class="flex items-center font-display text-2xl text-[var(--ink)]" style="letter-spacing: 0.18em;">
        <span>A</span>
        <span class="relative inline-block">
          <GoldArc size={14} class="absolute left-1/2 -top-2.5 -translate-x-1/2" />
          U
        </span>
        <span>RELIA</span>
      </span>
      <span class="overline mt-1 text-[9px]">MEDYCYNA ESTETYCZNA · TORUŃ</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Nawigacja główna">
      <div class="group relative">
        <button
          type="button"
          class="flex items-center gap-1.5 text-[15px] font-medium text-[var(--ink)] transition-colors hover:text-[var(--gold)]"
          aria-expanded="false"
          aria-haspopup="true"
          id="zabiegi-trigger"
        >
          Zabiegi
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" class="transition-transform duration-200 group-focus-within:rotate-180 [.menu-open_&]:rotate-180">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
          </svg>
        </button>
        <div
          id="zabiegi-menu"
          class="invisible absolute left-0 top-full w-[560px] translate-y-1 rounded-sm border border-[var(--porcelain)] bg-white p-5 opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
        >
          <a
            href="/dobierz-zabieg"
            class="flex items-center justify-between gap-4 rounded-sm border border-[var(--gold-soft)] bg-[var(--porcelain)]/40 px-4 py-3 text-[14px] font-medium text-[var(--ink)] transition-colors hover:border-[var(--gold)] hover:text-[var(--gold)]"
          >
            Nie wiesz, co wybrać? <span class="font-semibold">Dobierz zabieg dla siebie</span>
            <span aria-hidden="true">→</span>
          </a>

          <div class="mt-4 grid grid-cols-3 gap-6">
            {zabiegiCategories.map((category) => (
              <div class="flex flex-col gap-2.5">
                <span class="overline text-[11px]">{category.label}</span>
                <ul class="flex flex-col gap-0.5">
                  {category.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="block rounded-sm px-2 py-1.5 text-[14px] leading-snug text-[var(--ink)] transition-colors hover:bg-[var(--ivory)] hover:text-[var(--gold)]"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <div class="mt-4 flex items-center justify-between border-t border-[var(--porcelain)] pt-4">
            {zabiegiUtility.map((item) => (
              <a
                href={item.href}
                class="text-[14px] font-medium text-[var(--ink)] transition-colors hover:text-[var(--gold)]"
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-[15px] font-medium text-[var(--ink)] transition-colors hover:text-[var(--gold)]"
        >
          {link.label}
        </a>
      ))}

      <span class="cursor-default text-[15px] font-medium text-[var(--ink-soft)]/50" aria-disabled="true">
        {upcomingNavLabel} <span class="text-[11px]">(wkrótce)</span>
      </span>

      <a
        href="/kontakt"
        class="inline-flex items-center border border-[var(--ink)] bg-[var(--porcelain)] px-6 py-3 text-[14px] font-medium text-[var(--ink)] transition-colors duration-300 hover:border-[var(--gold)] hover:bg-[#EADDD7] hover:text-[var(--gold)]"
      >
        Umów wizytę
      </a>
    </nav>

    <button
      type="button"
      id="mobile-menu-trigger"
      class="flex flex-col gap-1.5 p-2 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Otwórz menu"
    >
      <span class="h-px w-6 bg-[var(--ink)] transition-transform duration-300" id="bar-1"></span>
      <span class="h-px w-6 bg-[var(--ink)] transition-opacity duration-300" id="bar-2"></span>
      <span class="h-px w-6 bg-[var(--ink)] transition-transform duration-300" id="bar-3"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="invisible fixed inset-0 top-0 z-40 flex h-dvh flex-col gap-8 overflow-y-auto bg-white px-8 pt-[9.5rem] pb-12 opacity-0 transition-opacity duration-300 lg:hidden"
  >
    <nav class="flex flex-col gap-6" aria-label="Nawigacja mobilna">
      <div class="flex flex-col gap-5">
        <span class="overline">Zabiegi</span>
        {zabiegiCategories.map((category) => (
          <div class="flex flex-col gap-0.5">
            <span class="text-[12px] font-semibold uppercase tracking-[0.1em] text-[var(--ink-soft)]">
              {category.label}
            </span>
            {category.items.map((item) => (
              <a href={item.href} class="block py-3 text-[18px] text-[var(--ink)]">
                {item.label}
              </a>
            ))}
          </div>
        ))}
        <div class="flex flex-col gap-0.5 pt-1">
          {zabiegiUtility.map((item) => (
            <a href={item.href} class="block py-3 text-[18px] font-medium text-[var(--ink)]">
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <div class="h-px w-12 bg-[var(--gold-soft)]"></div>

      {navLinks.map((link) => (
        <a href={link.href} class="font-display text-3xl font-light text-[var(--ink)]">
          {link.label}
        </a>
      ))}

      <span class="cursor-default font-display text-3xl font-light text-[var(--ink-soft)]/50" aria-disabled="true">
        {upcomingNavLabel} <span class="text-base">(wkrótce)</span>
      </span>
    </nav>
    <a
      href="/kontakt"
      class="inline-flex items-center justify-center border border-[var(--ink)] bg-[var(--porcelain)] px-6 py-4 text-[15px] font-medium text-[var(--ink)] transition-colors duration-300 hover:border-[var(--gold)] hover:bg-[#EADDD7] hover:text-[var(--gold)]"
    >
      Umów wizytę
    </a>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (window.scrollY > 24) {
      header?.classList.add("is-scrolled");
    } else {
      header?.classList.remove("is-scrolled");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const trigger = document.getElementById("mobile-menu-trigger");
  const menu = document.getElementById("mobile-menu");

  const closeMobileMenu = () => {
    trigger?.setAttribute("aria-expanded", "false");
    trigger?.setAttribute("aria-label", "Otwórz menu");
    menu?.classList.remove("visible", "opacity-100");
    menu?.classList.add("invisible", "opacity-0");
    document.body.classList.remove("overflow-hidden");
    document.getElementById("bar-1")?.style.setProperty("transform", "");
    document.getElementById("bar-2")?.style.setProperty("opacity", "1");
    document.getElementById("bar-3")?.style.setProperty("transform", "");
  };

  const openMobileMenu = () => {
    trigger?.setAttribute("aria-expanded", "true");
    trigger?.setAttribute("aria-label", "Zamknij menu");
    menu?.classList.add("visible", "opacity-100");
    menu?.classList.remove("invisible", "opacity-0");
    document.body.classList.add("overflow-hidden");
    document.getElementById("bar-1")?.style.setProperty("transform", "translateY(6.5px) rotate(45deg)");
    document.getElementById("bar-2")?.style.setProperty("opacity", "0");
    document.getElementById("bar-3")?.style.setProperty("transform", "translateY(-6.5px) rotate(-45deg)");
  };

  trigger?.addEventListener("click", () => {
    const isOpen = trigger.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  const zabiegiTrigger = document.getElementById("zabiegi-trigger");
  zabiegiTrigger?.addEventListener("click", () => {
    const expanded = zabiegiTrigger.getAttribute("aria-expanded") === "true";
    zabiegiTrigger.setAttribute("aria-expanded", String(!expanded));
  });
</script>

<style>
  #site-header {
    background-color: transparent;
  }

  #site-header.is-scrolled {
    background-color: var(--white);
    box-shadow: 0 4px 24px rgba(34, 30, 26, 0.06);
  }
</style>
