---
import { Image } from "astro:assets";

interface Props {
  image: string;
  imageAlt: string;
  name: string;
  description: string;
}

const { image, imageAlt, name, description } = Astro.props;
---

<div class="flex flex-col gap-5">
  <div class="aspect-[4/5] w-full overflow-hidden bg-[var(--porcelain)]">
    <Image src={image} alt={imageAlt} width={900} height={1125} loading="lazy" class="h-full w-full object-cover" />
  </div>
  <div class="flex flex-col gap-2">
    <h3 class="font-display text-2xl font-normal text-[var(--ink)]">{name}</h3>
    <p class="text-[15px] text-[var(--ink-soft)]">{description}</p>
  </div>
</div>
