---
import { Image } from "astro:assets";

interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt: string;
  afterAlt: string;
  label: string;
}

const { beforeSrc, afterSrc, beforeAlt, afterAlt, label } = Astro.props;
---

<figure class="flex flex-col gap-3">
  <div
    class="before-after relative aspect-square w-full touch-none select-none overflow-hidden bg-[var(--porcelain)]"
    data-before-after
    role="slider"
    tabindex="0"
    aria-label={`Suwak przed i po: ${label}`}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    aria-valuetext="50 procent"
  >
    <Image
      src={beforeSrc}
      alt={beforeAlt}
      width={900}
      height={900}
      loading="lazy"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover"
    />
    <div class="pointer-events-none absolute inset-0" data-after-layer style="clip-path: inset(0 0 0 50%);">
      <Image
        src={afterSrc}
        alt={afterAlt}
        width={900}
        height={900}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>

    <span class="pointer-events-none absolute left-3 top-3 bg-white/85 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.1em] text-[var(--ink)]">
      Przed
    </span>
    <span class="pointer-events-none absolute right-3 top-3 bg-white/85 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.1em] text-[var(--ink)]">
      Po
    </span>

    <div class="pointer-events-none absolute inset-y-0 w-px bg-white" data-handle-line style="left: 50%;">
      <div
        class="absolute top-1/2 left-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-[var(--gold-soft)] bg-white shadow-md"
      >
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
          <path d="M5 1L1 6L5 11" stroke="var(--gold)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M11 1L15 6L11 11" stroke="var(--gold)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
  </div>
  <figcaption class="text-center text-[14px] text-[var(--ink-soft)]">{label}</figcaption>
</figure>

<script>
  function initBeforeAfter(root: HTMLElement) {
    const afterLayer = root.querySelector<HTMLElement>("[data-after-layer]");
    const handleLine = root.querySelector<HTMLElement>("[data-handle-line]");
    if (!afterLayer || !handleLine) return;

    let dragging = false;

    function setPosition(percent: number) {
      const clamped = Math.min(100, Math.max(0, percent));
      afterLayer!.style.clipPath = `inset(0 0 0 ${clamped}%)`;
      handleLine!.style.left = `${clamped}%`;
      root.setAttribute("aria-valuenow", String(Math.round(clamped)));
      root.setAttribute("aria-valuetext", `${Math.round(clamped)} procent`);
    }

    function percentFromClientX(clientX: number) {
      const rect = root.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * 100;
    }

    function onPointerMove(event: PointerEvent) {
      if (!dragging) return;
      setPosition(percentFromClientX(event.clientX));
    }

    function stopDrag() {
      dragging = false;
    }

    root.addEventListener("pointerdown", (event) => {
      dragging = true;
      root.focus();
      setPosition(percentFromClientX(event.clientX));
    });
    window.addEventListener("pointermove", onPointerMove);
    window.addEventListener("pointerup", stopDrag);

    root.addEventListener("keydown", (event) => {
      const current = parseFloat(root.getAttribute("aria-valuenow") || "50");
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setPosition(current - 5);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        setPosition(current + 5);
      } else if (event.key === "Home") {
        event.preventDefault();
        setPosition(0);
      } else if (event.key === "End") {
        event.preventDefault();
        setPosition(100);
      }
    });
  }

  document.querySelectorAll<HTMLElement>("[data-before-after]").forEach(initBeforeAfter);
</script>
